# Copy to .env (ignored). Never commit real keys.
DEPLOYER_PRIVATE_KEY=
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
# Demo wallet keys: server-side only (the dev server and the Vercel function read them; they are never put in the browser bundle).
# On Vercel add them as Environment Variables WITHOUT any public prefix.
DEMO_SUPPLIER_KEY=
DEMO_INVESTOR_KEY=
DEMO_INVESTOR2_KEY=
DEMO_DEBTOR_KEY=
DEMO_ATTESTER_KEY=
# Arkiv access key (not secret; it ships to the browser)
ARKIV_ACCESS_KEY=
